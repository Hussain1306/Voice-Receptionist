    {
      "id": "71700312-7c0e-497a-b04c-fdd2d303fd5b",
      "name": "Register Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        440
      ],
      "parameters": {
        "jsCode": "\nconst row = $('Prepare Retry').item.json.row;\nconst msg = String($json.error?.message || $json.error || '').slice(0, 200);\nconst dup = /409|already exists/i.test(msg);\nconst attempts = Number(row.attempts || 0) + 1;\nconst status = dup ? 'confirmed' : attempts >= 3 ? 'needs_human' : 'pending';\nreturn { json: { requestId: row.requestId, status, attempts, lastError: msg, name: row.name, phone: row.phone, service: row.service, start: row.start } };\n",
        "mode": "runOnceForEachItem"
      }
    },
