    {
      "id": "110197f0-f9a3-419e-befc-4051464eac30",
      "name": "Build Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        900
      ],
      "parameters": {
        "jsCode": "\nconst TZ = 'America/New_York', BIZ = 'Acme Dental';   // <-- match workflow 1 config\nconst items = ($input.first().json.items || []).filter(e => e.status !== 'cancelled' && e.extendedProperties?.private?.reminded !== 'true');\nreturn items.map(e => {\n  const p = e.extendedProperties?.private || {};\n  const label = DateTime.fromISO(e.start.dateTime, { zone: TZ }).toFormat(\"cccc, LLLL d 'at' h:mm a\");\n  const digits = String(p.phone || '').replace(/\\D/g, '');\n  return { json: { eventId: e.id, phone: digits ? '+' + digits : '', email: p.email || '', name: p.name || '', label,\n    sms: `${BIZ}: reminder - your appointment is ${label}. Need to change it? Call us.` } };\n});\n"
      }
    },
