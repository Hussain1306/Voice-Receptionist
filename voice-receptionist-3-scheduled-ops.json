    {
      "id": "9030dac8-e9b1-4776-8905-53a17a710c03",
      "name": "SMS - Booking Confirmed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        260
      ],
      "parameters": {
