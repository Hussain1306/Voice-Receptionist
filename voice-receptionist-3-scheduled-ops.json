    {
      "id": "73423eab-0172-4396-9884-a3b19d4e32ba",
      "name": "HITL - Manual Booking Decision",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1680,
        380
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "sendTo": "manager@yourcompany.com",
        "subject": "=Booking request needs a human: {{ $('Register Failure').item.json.name }}",
        "message": "=The system could not auto-confirm this appointment request after 3 attempts.\n\nName: {{ $('Register Failure').item.json.name }}\nPhone: {{ $('Register Failure').item.json.phone }}\nService: {{ $('Register Failure').item.json.service }}\nRequested start: {{ $('Register Failure').item.json.start }}\nLast error: {{ $('Register Failure').item.json.lastError }}\n\nApprove = staff will call the customer and book manually. Decline = close the request.",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "I'll handle it",
            "disapproveLabel": "Close request"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 24,
              "resumeUnit": "hours"
            }
          }
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE",
          "name": "Gmail account"
        }
      },
      "webhookId": "6d217c97-05f8-4862-ac10-545501935424"
    },
    {
      "id": "9c0865bf-f944-47b0-9ba1-692b566548b6",
      "name": "Make Resolution Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        380
      ],
      "parameters": {
        "jsCode": "\nconst f = $('Register Failure').item.json, ok = $input.first().json?.data?.approved === true;\nreturn { json: { requestId: f.requestId, status: ok ? 'manual_followup' : 'closed', phone: f.phone,\n  sms: ok ? 'Thanks for your request - a team member will call you shortly to confirm your appointment.' : 'Sorry, we could not confirm your requested time. Please call us and we will find a slot that works.' } };\n",
        "mode": "runOnceForEachItem"
      }
    },
